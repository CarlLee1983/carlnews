{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carlnews",
  "compatibility_date": "2026-11-17",
  "routes": [
    {
      "pattern": "carlnews.gravito.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
