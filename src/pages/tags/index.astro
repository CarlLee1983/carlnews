---
import EmptyState from "../../components/EmptyState.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectTaxonomy, getVisiblePosts } from "../../utils/collections";
import { sortByPostCount } from "../../utils/content";

const tags = sortByPostCount(collectTaxonomy(await getVisiblePosts(), "tags"));
const tierOf = (count: number) =>
  count >= 10 ? "major" : count >= 3 ? "minor" : "single";
---

<BaseLayout
  title="標籤"
  description="由 CarlNews 已發布時事評論自動產生的公司、人物與議題標籤。"
>
  <div class="page shell">
    <header class="page-header">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>ENTITIES & TOPICS · {tags.length}</span>
      </div>
      <h1>標籤</h1>
      <p>
        標記具體公司、人物、技術標準或跨版面議題，名稱與穩定 URL
        由內容集合自動生成。
      </p>
    </header>
    {
      tags.length > 0 ? (
        <ul class="tag-list tags-cloud" aria-label="全部時事標籤">
          {tags.map((tag) => (
            <li>
              <a
                class="tag"
                data-count={tag.posts.length}
                data-tier={tierOf(tag.posts.length)}
                href={`/tags/${tag.slug}/`}
              >
                {tag.name}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          title="尚無已發布時事標籤"
          description="發布第一篇時事評論後，這裡會自動建立標籤入口。"
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .tags-cloud :global(.tag[data-tier="major"]) {
    min-height: 2.5rem;
    padding-inline: var(--space-md);
    background: var(--color-card);
    border: var(--rule-hair) solid var(--color-rule-2);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .tags-cloud :global(.tag[data-tier="single"]) {
    background: transparent;
    border: var(--rule-hair) solid var(--color-rule);
    color: var(--color-muted);
    font-weight: 500;
  }
</style>
