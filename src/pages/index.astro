---
import ArticleCard from "../components/ArticleCard.astro";
import EmptyState from "../components/EmptyState.astro";
import SeriesCard from "../components/SeriesCard.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  categoryHref,
  collectCategories,
  collectTaxonomy,
  getVisiblePosts,
  postHref,
} from "../utils/collections";
import {
  estimateReadingMinutes,
  getArticleListDate,
  selectFeaturedPosts,
  sortByPostCount,
} from "../utils/content";

const posts = await getVisiblePosts();
const latest = posts.slice(0, 5);
const leadPost = latest[0];
const railPosts = latest.slice(1, 5);
const featured = selectFeaturedPosts(posts, {
  now: new Date(),
  limit: 3,
  exclude: latest,
});
const categories = collectCategories(posts);
const seriesList = sortByPostCount(collectTaxonomy(posts, "series")).slice(
  0,
  3,
);

const todayLabel = new Intl.DateTimeFormat("zh-TW", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "short",
  timeZone: "Asia/Taipei",
}).format(new Date());

const leadDate = leadPost ? getArticleListDate(leadPost.data) : null;
const leadBody =
  leadPost && "body" in leadPost && typeof leadPost.body === "string"
    ? leadPost.body
    : "";
---

<BaseLayout title={siteConfig.name}>
  <div class="shell home">
    <!-- 1. Editorial Masthead + Desk Strip -->
    <section class="masthead" aria-label="報頭與版面快選">
      <div class="masthead__top">
        <div class="masthead__meta">
          <span class="masthead__kicker">{todayLabel}</span>
          <h1>{siteConfig.name}</h1>
          <p class="masthead__subtitle">{siteConfig.description}</p>
        </div>
        <div class="masthead__actions">
          <a class="button" href="/news/">全部時事（{posts.length}）</a>
          <a class="text-link masthead__method" href="/about/">判讀方法 →</a>
        </div>
      </div>

      <nav class="desk-strip" aria-label="7 大版面快選">
        {
          categories.map((category) => (
            <a
              class="desk-strip__item"
              data-desk={category.name}
              href={`/category/${category.slug}/`}
            >
              <span class="desk-strip__dot" aria-hidden="true" />
              <span>{category.name}</span>
              <span class="desk-strip__count">{category.posts.length}</span>
            </a>
          ))
        }
      </nav>
    </section>

    <!-- 2. Front-Page Dual-Column Lead + Dispatch Stream -->
    <section class="frontpage-section" aria-labelledby="frontpage-heading">
      <div class="section-head">
        <h2 id="frontpage-heading">頭條判讀與近期評論</h2>
        <a href="/news/">完整時事索引 →</a>
      </div>

      {
        leadPost && leadDate ? (
          <div class="frontpage-grid">
            <article class="lead-dossier" data-desk={leadPost.data.category}>
              <div class="lead-dossier__meta">
                <a
                  class="lead-dossier__desk"
                  data-desk={leadPost.data.category}
                  href={categoryHref(leadPost.data.category)}
                >
                  {leadPost.data.category}
                </a>
                <span aria-hidden="true">·</span>
                <time datetime={leadDate.datetime}>{leadDate.text}</time>
                <span aria-hidden="true">·</span>
                <span>閱讀約 {estimateReadingMinutes(leadBody)} 分鐘</span>
              </div>

              <h3 class="lead-dossier__title">
                <a href={postHref(leadPost)}>{leadPost.data.title}</a>
              </h3>
              <p class="lead-dossier__desc">{leadPost.data.description}</p>

              <dl class="lead-dossier__brief">
                <div data-q="1">
                  <dt>
                    <span class="lead-q">發生什麼事</span>
                  </dt>
                  <dd>{leadPost.data.whatHappened}</dd>
                </div>
                <div data-q="2">
                  <dt>
                    <span class="lead-q">為什麼重要</span>
                  </dt>
                  <dd>{leadPost.data.whyItMatters}</dd>
                </div>
                <div data-q="3">
                  <dt>
                    <span class="lead-q">後續怎麼看</span>
                  </dt>
                  <dd>{leadPost.data.whatNext}</dd>
                </div>
              </dl>

              <div class="lead-dossier__footer">
                <a class="text-link" href={postHref(leadPost)}>
                  閱讀完整判讀與消息來源（{leadPost.data.sources.length} 筆）→
                </a>
              </div>
            </article>

            <aside class="dispatch-rail" aria-label="近期時事評論">
              <div class="dispatch-rail__head">
                <span>近期評論</span>
                <a href="/news/">全部 →</a>
              </div>
              {railPosts.length > 0 ? (
                <ul class="dispatch-rail__list">
                  {railPosts.map((post) => {
                    const itemDate = getArticleListDate(post.data);
                    return (
                      <li class="dispatch-rail__item">
                        <div class="dispatch-rail__meta">
                          <span
                            class="dispatch-rail__desk"
                            data-desk={post.data.category}
                          >
                            {post.data.category}
                          </span>
                          <span aria-hidden="true">·</span>
                          <time datetime={itemDate.datetime}>
                            {itemDate.text}
                          </time>
                        </div>
                        <h3 class="dispatch-rail__title">
                          <a href={postHref(post)}>{post.data.title}</a>
                        </h3>
                        <p class="dispatch-rail__why">
                          <strong>為什麼重要：</strong>
                          {post.data.whyItMatters}
                        </p>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <div class="dispatch-rail__empty">
                  <p>
                    目前最新一篇頭條已展開於左側。持續發布新事件後，近期評論會依更新時間排列於此。
                  </p>
                  <a class="text-link" href="/category/">
                    瀏覽 7 大版面 →
                  </a>
                </div>
              )}
            </aside>
          </div>
        ) : (
          <EmptyState
            title="尚無已發布時事評論"
            description="在 src/content/news 新增檔案並設為 draft: false 後會顯示在這裡。"
          />
        )
      }
    </section>

    <!-- 3. Featured Briefs -->
    {
      featured.length > 0 && (
        <section class="section" aria-labelledby="featured-heading">
          <div class="section-head">
            <h2 id="featured-heading">精選判讀</h2>
            <a href="/news/">完整索引 →</a>
          </div>
          <div class="article-grid">
            {featured.map((post) => (
              <ArticleCard
                post={post}
                variant="card"
                headingLevel="h3"
                showBrief={true}
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- 4. Editorial Desks Matrix -->
    <section class="section" aria-labelledby="categories-heading">
      <div class="section-head">
        <h2 id="categories-heading">七大固定版面</h2>
        <a href="/category/">版面總覽 →</a>
      </div>
      <div class="desk-matrix">
        {
          categories.map((category) => (
            <a
              class="desk-card"
              data-desk={category.name}
              href={`/category/${category.slug}/`}
            >
              <div class="desk-card__top">
                <h3 class="desk-card__name">{category.name}</h3>
                <span class="desk-card__count">{category.posts.length} 篇</span>
              </div>
              <p class="desk-card__preview">
                {category.posts[0]
                  ? `最新：${category.posts[0].data.title}`
                  : "尚待收錄新評論"}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 5. Tracked Storylines -->
    {
      seriesList.length > 0 && (
        <section class="section" aria-labelledby="series-heading">
          <div class="section-head">
            <h2 id="series-heading">事件脈絡追蹤</h2>
            <a href="/series/">所有脈絡 →</a>
          </div>
          <div class="article-grid">
            {seriesList.map((item) => (
              <SeriesCard
                name={item.name}
                slug={item.slug}
                posts={item.posts}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: 0;
    padding-block-end: var(--space-4xl);
  }

  /* 1. Masthead */
  .masthead {
    display: grid;
    gap: var(--space-lg);
    margin-block-start: var(--space-xl);
    padding-block: var(--space-lg) 0;
    border-block-end: var(--rule-hair) solid var(--color-rule-2);
  }

  .masthead__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-lg);
  }

  .masthead__meta {
    display: grid;
    gap: var(--space-xs);
  }

  .masthead__kicker {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .masthead__meta h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .masthead__subtitle {
    max-width: 50ch;
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.7;
  }

  .masthead__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .masthead__actions .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.35rem;
    padding-inline: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule-2);
    background: transparent;
    color: var(--color-ink);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .masthead__actions .button:hover {
    border-color: var(--color-ink);
  }

  .masthead__method {
    color: var(--color-muted);
  }

  .masthead__method:hover {
    color: var(--color-accent);
  }

  .desk-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-lg);
    padding-block: var(--space-sm);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .desk-strip__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding-block: var(--space-xs);
    color: var(--color-ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .desk-strip__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: var(--desk-color);
    flex: none;
  }

  .desk-strip__item:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .desk-strip__count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 2. Front-Page Lead + Dispatch Stream */
  .frontpage-section {
    padding-block: var(--space-2xl);
  }

  .frontpage-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .lead-dossier {
    display: grid;
    gap: var(--space-md);
    min-width: 0;
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule-2);
  }

  .lead-dossier__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .lead-dossier__desk {
    color: var(--desk-color);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .lead-dossier__desk:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .lead-dossier__title {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    line-height: 1.3;
  }

  .lead-dossier__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .lead-dossier__title a:hover {
    color: var(--color-accent);
  }

  .lead-dossier__desc {
    color: var(--color-ink-2);
    font-size: var(--text-base);
    line-height: 1.8;
  }

  .lead-dossier__brief {
    display: grid;
    gap: 0;
    margin: var(--space-xs) 0 0;
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .lead-dossier__brief div {
    display: grid;
    gap: 0.25rem;
    padding-block: var(--space-md);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .lead-dossier__brief div:first-child {
    border-block-start: none;
  }

  .lead-q {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-muted);
  }

  .lead-dossier__brief dd {
    margin: 0;
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    line-height: 1.72;
  }

  .lead-dossier__footer {
    padding-block-start: var(--space-xs);
  }

  .dispatch-rail {
    display: grid;
    gap: 0;
    min-width: 0;
    padding-inline-start: var(--space-xl);
    border-inline-start: var(--rule-hair) solid var(--color-rule);
  }

  .dispatch-rail__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-lg) var(--space-sm);
    border-block-end: var(--rule-hair) solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-muted);
  }

  .dispatch-rail__head a {
    white-space: nowrap;
    color: var(--color-muted);
  }

  .dispatch-rail__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dispatch-rail__item {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .dispatch-rail__item:first-child {
    border-block-start: none;
  }

  .dispatch-rail__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .dispatch-rail__desk {
    color: var(--desk-color);
    font-weight: 700;
  }

  .dispatch-rail__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: 1.4;
  }

  .dispatch-rail__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .dispatch-rail__title a:hover {
    color: var(--color-accent);
  }

  .dispatch-rail__why {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.65;
  }

  .dispatch-rail__why strong {
    color: var(--color-ink-2);
  }

  .dispatch-rail__empty {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  /* 4. Desk Matrix */
  .desk-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0 var(--space-xl);
  }

  .desk-card {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
    padding-block: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
    color: inherit;
    text-decoration: none;
  }

  .desk-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .desk-card__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .desk-card__name {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--color-ink);
  }

  .desk-card__name::before {
    content: "";
    width: 0.35rem;
    height: 0.35rem;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--desk-color);
  }

  .desk-card:hover .desk-card__name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .desk-card__preview {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  @media (max-width: 56rem) {
    .dispatch-rail {
      padding-inline-start: 0;
      border-inline-start: none;
      border-block-start: var(--rule-hair) solid var(--color-rule-2);
    }

    .frontpage-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
