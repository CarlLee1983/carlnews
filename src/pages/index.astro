---
import ArticleCard from "../components/ArticleCard.astro";
import EmptyState from "../components/EmptyState.astro";
import SeriesCard from "../components/SeriesCard.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  collectCategories,
  collectTaxonomy,
  getVisiblePosts,
} from "../utils/collections";
import { selectFeaturedPosts, sortByPostCount } from "../utils/content";

const posts = await getVisiblePosts();
const latest = posts.slice(0, 5);
const featured = selectFeaturedPosts(posts, {
  now: new Date(),
  limit: 3,
  exclude: latest,
});
const categories = collectCategories(posts);
const seriesList = sortByPostCount(collectTaxonomy(posts, "series")).slice(
  0,
  3,
);
const tags = collectTaxonomy(posts, "tags");

const latestDate = latest[0]?.data.updatedDate ?? latest[0]?.data.publishDate;
const stats = [
  { value: posts.length, label: "篇時事評論" },
  { value: categories.length, label: "個固定版面" },
  { value: tags.length, label: "個關鍵標籤" },
];
const latestLabel = latestDate
  ? new Intl.DateTimeFormat("zh-TW", {
      month: "long",
      day: "numeric",
      timeZone: "Asia/Taipei",
    }).format(latestDate)
  : null;
---

<BaseLayout title={siteConfig.name}>
  <div class="shell home">
    <section class="home-hero">
      <div class="home-hero__copy">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>TECH × AI × GLOBAL BRIEFINGS</span>
        </div>
        <h1>看懂正在發生的事，<br />也看清接下來怎麼走。</h1>
        <p class="home-hero__lede">
          {siteConfig.description}
        </p>
        <div class="home-hero__actions">
          <a class="button" href="/news/">閱讀最新時事</a>
          <a class="text-link" href="/category/">瀏覽 7 大版面 →</a>
        </div>
      </div>

      <aside class="hero-spec-card" aria-label="站點速覽">
        <div class="hero-spec-card__header">
          <span>站點速覽</span>
        </div>
        <dl class="hero-stats">
          {
            stats.map((stat) => (
              <div class="hero-stats__item">
                <dd>{stat.value}</dd>
                <dt>{stat.label}</dt>
              </div>
            ))
          }
        </dl>
        <p class="hero-spec-card__desc">
          {latestLabel && <span>最近更新 {latestLabel}。</span>}
          每篇皆提供「發生什麼事、為什麼重要、後續怎麼看」三問速覽與一手消息來源。
        </p>
      </aside>
    </section>

    <section class="section" aria-labelledby="latest-heading">
      <div class="section-head">
        <h2 id="latest-heading">最新時事判讀</h2>
        <a href="/news/">全部時事 →</a>
      </div>
      {
        latest.length > 0 ? (
          <div class="article-list">
            {latest.map((post) => (
              <ArticleCard post={post} variant="row" headingLevel="h3" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="尚無已發布時事評論"
            description="在 src/content/news 新增檔案並設為 draft: false 後會顯示在這裡。"
          />
        )
      }
    </section>

    {
      featured.length > 0 && (
        <section class="section" aria-labelledby="featured-heading">
          <div class="section-head">
            <h2 id="featured-heading">精選判讀</h2>
            <a href="/news/">完整索引 →</a>
          </div>
          <div class="article-grid">
            {featured.map((post) => (
              <ArticleCard
                post={post}
                variant="card"
                headingLevel="h3"
                showBrief={true}
              />
            ))}
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="categories-heading">
      <div class="section-head">
        <h2 id="categories-heading">版面導覽</h2>
        <a href="/category/">全部版面 →</a>
      </div>
      <ul class="topic-cloud">
        {
          categories.map((category) => (
            <li>
              <a href={`/category/${category.slug}/`}>
                <span>{category.name}</span>
                <span class="muted">{category.posts.length} 篇</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      seriesList.length > 0 && (
        <section class="section" aria-labelledby="series-heading">
          <div class="section-head">
            <h2 id="series-heading">事件脈絡追蹤</h2>
            <a href="/series/">所有脈絡 →</a>
          </div>
          <div class="article-grid">
            {seriesList.map((item, index) => (
              <SeriesCard
                name={item.name}
                slug={item.slug}
                posts={item.posts}
                index={index}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: 0;
    padding-block-end: var(--space-4xl);
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.9fr);
    gap: var(--space-2xl);
    align-items: center;
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .home-hero__copy {
    display: grid;
    gap: var(--space-md);
  }

  .home-hero h1 {
    font-size: clamp(2.1rem, 4.5vw, 3.25rem);
    line-height: 1.2;
  }

  .home-hero__lede {
    max-width: 50ch;
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.75;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-block-start: var(--space-xs);
  }

  .home-hero__actions .button {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .hero-spec-card {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
  }

  .hero-spec-card__header {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding-block: var(--space-sm);
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  .hero-stats__item {
    display: grid;
    gap: 0.15rem;
  }

  .hero-stats__item dd {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .hero-stats__item dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .hero-spec-card__desc {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  @media (max-width: 56rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
