---
import ArticleCard from "../components/ArticleCard.astro";
import EmptyState from "../components/EmptyState.astro";
import SeriesCard from "../components/SeriesCard.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  categoryHref,
  collectCategories,
  collectTaxonomy,
  getVisiblePosts,
  postHref,
} from "../utils/collections";
import {
  estimateReadingMinutes,
  getArticleListDate,
  selectFeaturedPosts,
  sortByPostCount,
} from "../utils/content";

const posts = await getVisiblePosts();
const latest = posts.slice(0, 5);
const leadPost = latest[0];
const railPosts = latest.slice(1, 5);
const featured = selectFeaturedPosts(posts, {
  now: new Date(),
  limit: 3,
  exclude: latest,
});
const categories = collectCategories(posts);
const seriesList = sortByPostCount(collectTaxonomy(posts, "series")).slice(
  0,
  3,
);
const allSeriesCount = collectTaxonomy(posts, "series").length;

const todayLabel = new Intl.DateTimeFormat("zh-TW", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "short",
  timeZone: "Asia/Taipei",
}).format(new Date());

const leadDate = leadPost ? getArticleListDate(leadPost.data) : null;
const leadBody =
  leadPost && "body" in leadPost && typeof leadPost.body === "string"
    ? leadPost.body
    : "";

const stats = [
  { value: posts.length, label: "篇時事評論" },
  { value: categories.length, label: "個固定版面" },
  { value: allSeriesCount, label: "條追蹤脈絡" },
];
---

<BaseLayout title={siteConfig.name}>
  <div class="shell home">
    <!-- 1. Editorial Masthead + Desk Strip -->
    <section class="masthead" aria-label="報頭與版面快選">
      <div class="masthead__top">
        <div class="masthead__meta">
          <span class="masthead__kicker">TAIPEI DISPATCH · {todayLabel}</span>
          <h1>{siteConfig.name}</h1>
          <p class="masthead__subtitle">{siteConfig.description}</p>
        </div>
        <aside class="masthead__stats" aria-label="站點即時統計">
          <dl>
            {
              stats.map((stat) => (
                <div class="masthead__stat-item">
                  <dd>{stat.value}</dd>
                  <dt>{stat.label}</dt>
                </div>
              ))
            }
          </dl>
          <div class="masthead__actions">
            <a class="button" href="/news/">全部時事</a>
            <a class="text-link" href="/about/">判讀方法 →</a>
          </div>
        </aside>
      </div>

      <nav class="desk-strip" aria-label="7 大版面快選">
        {
          categories.map((category) => (
            <a class="desk-strip__item" href={`/category/${category.slug}/`}>
              <span>{category.name}</span>
              <span class="desk-strip__count">{category.posts.length}</span>
            </a>
          ))
        }
      </nav>
    </section>

    <!-- 2. Front-Page Dual-Column Lead + Dispatch Stream -->
    <section class="frontpage-section" aria-labelledby="frontpage-heading">
      <div class="section-head">
        <div>
          <span class="section-head__kicker">01 // FRONT PAGE LEAD</span>
          <h2 id="frontpage-heading">頭條判讀與快訊流</h2>
        </div>
        <a href="/news/">完整時事索引 →</a>
      </div>

      {
        leadPost && leadDate ? (
          <div class="frontpage-grid">
            <article class="lead-dossier">
              <div class="lead-dossier__meta">
                <a
                  class="lead-dossier__desk"
                  href={categoryHref(leadPost.data.category)}
                >
                  {leadPost.data.category}
                </a>
                <time datetime={leadDate.datetime}>{leadDate.text}</time>
                <span>·</span>
                <span>{estimateReadingMinutes(leadBody)} 分鐘</span>
              </div>

              <h3 class="lead-dossier__title">
                <a href={postHref(leadPost)}>{leadPost.data.title}</a>
              </h3>
              <p class="lead-dossier__desc">{leadPost.data.description}</p>

              <dl class="lead-dossier__brief">
                <div>
                  <dt>
                    <span>01</span> 發生什麼事
                  </dt>
                  <dd>{leadPost.data.whatHappened}</dd>
                </div>
                <div>
                  <dt>
                    <span>02</span> 為什麼重要
                  </dt>
                  <dd>{leadPost.data.whyItMatters}</dd>
                </div>
                <div>
                  <dt>
                    <span>03</span> 後續怎麼看
                  </dt>
                  <dd>{leadPost.data.whatNext}</dd>
                </div>
              </dl>

              <div class="lead-dossier__footer">
                <a class="text-link" href={postHref(leadPost)}>
                  閱讀完整判讀與消息來源（{leadPost.data.sources.length} 筆）→
                </a>
              </div>
            </article>

            <aside class="dispatch-rail" aria-label="近期時事快訊流">
              <div class="dispatch-rail__head">
                <span>DISPATCH STREAM</span>
                <a href="/news/">全部 →</a>
              </div>
              {railPosts.length > 0 ? (
                <ul class="dispatch-rail__list">
                  {railPosts.map((post) => {
                    const itemDate = getArticleListDate(post.data);
                    return (
                      <li class="dispatch-rail__item">
                        <div class="dispatch-rail__meta">
                          <span class="dispatch-rail__desk">
                            {post.data.category}
                          </span>
                          <time datetime={itemDate.datetime}>
                            {itemDate.text}
                          </time>
                        </div>
                        <h3 class="dispatch-rail__title">
                          <a href={postHref(post)}>{post.data.title}</a>
                        </h3>
                        <p class="dispatch-rail__why">
                          <strong>為什麼重要：</strong>
                          {post.data.whyItMatters}
                        </p>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <div class="dispatch-rail__empty">
                  <p>
                    目前首篇頭條已展開於左側。持續發布新事件後，近期快訊流會依最近更新自動排列於此欄。
                  </p>
                  <a class="text-link" href="/category/">
                    瀏覽 7 大版面 →
                  </a>
                </div>
              )}
            </aside>
          </div>
        ) : (
          <EmptyState
            title="尚無已發布時事評論"
            description="在 src/content/news 新增檔案並設為 draft: false 後會顯示在這裡。"
          />
        )
      }
    </section>

    <!-- 3. Featured Briefs -->
    {
      featured.length > 0 && (
        <section class="section" aria-labelledby="featured-heading">
          <div class="section-head">
            <div>
              <span class="section-head__kicker">02 // FEATURED BRIEFS</span>
              <h2 id="featured-heading">精選判讀</h2>
            </div>
            <a href="/news/">完整索引 →</a>
          </div>
          <div class="article-grid">
            {featured.map((post) => (
              <ArticleCard
                post={post}
                variant="card"
                headingLevel="h3"
                showBrief={true}
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- 4. Editorial Desks Matrix -->
    <section class="section" aria-labelledby="categories-heading">
      <div class="section-head">
        <div>
          <span class="section-head__kicker">03 // EDITORIAL DESKS</span>
          <h2 id="categories-heading">七大固定版面</h2>
        </div>
        <a href="/category/">版面總覽 →</a>
      </div>
      <div class="desk-matrix">
        {
          categories.map((category, idx) => (
            <a class="desk-card" href={`/category/${category.slug}/`}>
              <div class="desk-card__top">
                <span class="desk-card__num">
                  {String(idx + 1).padStart(2, "0")}
                </span>
                <span class="desk-card__count">{category.posts.length} 篇</span>
              </div>
              <h3 class="desk-card__name">{category.name}</h3>
              <p class="desk-card__preview">
                {category.posts[0]
                  ? `最新：${category.posts[0].data.title}`
                  : "尚待收錄新評論"}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 5. Tracked Storylines -->
    {
      seriesList.length > 0 && (
        <section class="section" aria-labelledby="series-heading">
          <div class="section-head">
            <div>
              <span class="section-head__kicker">04 // STORYLINES</span>
              <h2 id="series-heading">事件脈絡追蹤</h2>
            </div>
            <a href="/series/">所有脈絡 →</a>
          </div>
          <div class="article-grid">
            {seriesList.map((item, index) => (
              <SeriesCard
                name={item.name}
                slug={item.slug}
                posts={item.posts}
                index={index}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: 0;
    padding-block-end: var(--space-4xl);
  }

  /* 1. Masthead */
  .masthead {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-xl) var(--space-xl);
    border-block-end: var(--rule-strong) solid var(--color-ink);
  }

  .masthead__top {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.85fr);
    gap: var(--space-xl);
    align-items: end;
  }

  .masthead__meta {
    display: grid;
    gap: var(--space-xs);
  }

  .masthead__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .masthead__meta h1 {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .masthead__subtitle {
    max-width: 52ch;
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.65;
  }

  .masthead__stats {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule-2);
    border-block-start: var(--rule-masthead) solid var(--color-ink);
    border-radius: var(--radius-md);
    background: var(--color-card);
  }

  .masthead__stats dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
  }

  .masthead__stat-item {
    display: grid;
    gap: 0.1rem;
  }

  .masthead__stat-item dd {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .masthead__stat-item dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .masthead__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding-block-start: var(--space-sm);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .masthead__actions .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.35rem;
    padding-inline: var(--space-md);
    font-size: var(--text-xs);
    text-decoration: none;
    white-space: nowrap;
  }

  .desk-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-block-start: var(--space-md);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .desk-strip__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.2rem;
    padding: 0.25rem 0.7rem;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: var(--color-card);
    color: var(--color-ink-2);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }

  .desk-strip__item:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .desk-strip__count {
    font-family: var(--font-mono);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 2. Front-Page Lead + Dispatch Stream */
  .frontpage-section {
    padding-block: var(--space-2xl);
  }

  .frontpage-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .lead-dossier {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl);
    border: var(--rule-hair) solid var(--color-rule-2);
    border-block-start: var(--rule-masthead) solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-card);
  }

  .lead-dossier__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .lead-dossier__desk {
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .lead-dossier__desk:hover {
    background: var(--color-accent-hover);
    color: var(--color-accent-ink);
  }

  .lead-dossier__title {
    font-size: clamp(1.5rem, 2.8vw, 2.05rem);
    line-height: 1.25;
  }

  .lead-dossier__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .lead-dossier__title a:hover {
    color: var(--color-accent);
  }

  .lead-dossier__desc {
    color: var(--color-ink-2);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .lead-dossier__brief {
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-xs) 0 0;
    padding: var(--space-md);
    background: var(--color-paper-2);
    border-radius: var(--radius-sm);
    border-inline-start: 3px solid var(--color-ink);
  }

  .lead-dossier__brief div {
    display: grid;
    gap: 0.2rem;
    padding-block-start: var(--space-xs);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .lead-dossier__brief div:first-child {
    padding-block-start: 0;
    border-block-start: none;
  }

  .lead-dossier__brief dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-ink);
  }

  .lead-dossier__brief dt span {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .lead-dossier__brief dd {
    margin: 0;
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .lead-dossier__footer {
    padding-block-start: var(--space-xs);
  }

  .dispatch-rail {
    display: grid;
    gap: 0;
    border: var(--rule-hair) solid var(--color-rule-2);
    border-block-start: var(--rule-masthead) solid var(--color-secondary);
    border-radius: var(--radius-md);
    background: var(--color-card);
    overflow: hidden;
  }

  .dispatch-rail__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-paper-2);
    border-block-end: var(--rule-hair) solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .dispatch-rail__head a {
    white-space: nowrap;
  }

  .dispatch-rail__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dispatch-rail__item {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .dispatch-rail__item:first-child {
    border-block-start: none;
  }

  .dispatch-rail__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .dispatch-rail__desk {
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--color-secondary-soft);
    color: var(--color-secondary);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .dispatch-rail__title {
    font-size: var(--text-md);
    line-height: 1.35;
  }

  .dispatch-rail__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .dispatch-rail__title a:hover {
    color: var(--color-accent);
  }

  .dispatch-rail__why {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .dispatch-rail__why strong {
    color: var(--color-ink-2);
  }

  .dispatch-rail__empty {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  /* 4. Desk Matrix */
  .desk-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-md);
  }

  .desk-card {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
    border-block-start: var(--rule-strong) solid var(--color-rule-2);
    border-radius: var(--radius-md);
    background: var(--color-card);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-micro) var(--ease-out);
  }

  .desk-card:hover {
    border-color: var(--color-accent);
  }

  .desk-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .desk-card__num {
    color: var(--color-accent);
    font-weight: 700;
  }

  .desk-card__count {
    color: var(--color-muted);
  }

  .desk-card__name {
    font-size: var(--text-md);
    color: var(--color-ink);
  }

  .desk-card:hover .desk-card__name {
    color: var(--color-accent);
  }

  .desk-card__preview {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  @media (max-width: 56rem) {
    .masthead__top,
    .frontpage-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
