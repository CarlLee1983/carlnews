---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectCategories, getVisiblePosts } from "../../utils/collections";

const posts = await getVisiblePosts();
const categories = collectCategories(posts);
---

<BaseLayout
  title="版面導覽"
  description="CarlNews 的 7 大固定時事版面：科技與商業、AI 與模型、半導體與硬體、產品與生態、政策與監管、國際時事、生活與社會。"
>
  <div class="page shell">
    <header class="page-header">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>Editorial Desks · {categories.length}</span>
      </div>
      <h1>版面導覽</h1>
      <p>
        每篇時事評論依核心影響維度歸入七大固定版面，方便追蹤產業鏈、政策法規與國際動向。
      </p>
    </header>

    <div class="category-grid">
      {
        categories.map((category) => (
          <a class="category-card" href={`/category/${category.slug}/`}>
            <div class="category-card__head">
              <h2>{category.name}</h2>
              <span class="category-card__count">
                {category.posts.length} 篇
              </span>
            </div>
            {category.posts[0] ? (
              <p class="category-card__latest">
                最新：{category.posts[0].data.title}
              </p>
            ) : (
              <p class="category-card__empty">尚無收錄評論</p>
            )}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-lg);
  }

  .category-card {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-xl);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-short) var(--ease-out);
  }

  .category-card:hover {
    border-color: var(--color-accent);
  }

  .category-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .category-card__head h2 {
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  .category-card:hover .category-card__head h2 {
    color: var(--color-accent);
  }

  .category-card__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    font-weight: 700;
  }

  .category-card__latest,
  .category-card__empty {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.55;
  }
</style>
