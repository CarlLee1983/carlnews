---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="找不到頁面"
  description="這個 CarlNews 頁面不存在或已移動。"
  noindex
>
  <div class="page shell not-found">
    <div class="not-found__content">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>HTTP 404 · PAGE NOT FOUND</span>
      </div>
      <h1>找不到這個頁面。</h1>
      <p class="not-found__desc">
        可能是網址拼寫有誤、該篇時事評論尚未公開，或路徑已調整。你可以直接搜尋關鍵字，或回到主要入口瀏覽。
      </p>

      <form class="search-form" action="/search/" method="get" role="search">
        <label class="visually-hidden" for="not-found-query"
          >搜尋 CarlNews</label
        >
        <input
          id="not-found-query"
          name="q"
          type="search"
          placeholder="搜尋公司、AI、半導體或政策關鍵字…"
          required
        />
        <button class="button" type="submit">搜尋</button>
      </form>

      <nav class="not-found__nav" aria-label="推薦導覽路徑">
        <a class="tag" href="/news/">時事索引</a>
        <a class="tag" href="/category/">版面導覽</a>
        <a class="tag" href="/series/">事件脈絡</a>
        <a class="tag" href="/tags/">關鍵標籤</a>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found__content {
    display: grid;
    gap: var(--space-md);
    max-width: 42rem;
  }

  .not-found h1 {
    font-size: clamp(2rem, 5vw, var(--text-3xl));
  }

  .not-found__desc {
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.75;
  }

  .not-found__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-sm);
  }
</style>
