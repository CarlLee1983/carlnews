---
import type { GetStaticPaths } from "astro";
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  collectTaxonomy,
  getSeriesPosts,
  getVisiblePosts,
} from "../../utils/collections";
import { estimateReadingMinutes } from "../../utils/content";

export const getStaticPaths = (async () => {
  const posts = await getVisiblePosts();
  return collectTaxonomy(posts, "series").map((series) => ({
    params: { series: series.slug },
    props: { series: { ...series, posts: getSeriesPosts(posts, series.name) } },
  }));
}) satisfies GetStaticPaths;

const { series } = Astro.props;

const totalReadingMinutes = series.posts.reduce((acc, p) => {
  const body = "body" in p && typeof p.body === "string" ? p.body : "";
  return acc + estimateReadingMinutes(body);
}, 0);
---

<BaseLayout
  title={`事件脈絡：${series.name}`}
  description={`CarlNews「${series.name}」事件脈絡連續追蹤評論。`}
>
  <div class="page shell">
    <div class="series-nav">
      <a class="text-link" href="/series/">← 返回所有事件脈絡</a>
    </div>

    <header class="page-header">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>STORYLINE · {series.posts.length} 篇</span>
      </div>
      <h1>{series.name}</h1>
      <p>
        依事件推進時間軸排列，總預估閱讀時間約 {totalReadingMinutes} 分鐘。
      </p>
    </header>

    <div class="article-list">
      {series.posts.map((post) => <ArticleCard post={post} variant="row" />)}
    </div>
  </div>
</BaseLayout>

<style>
  .series-nav {
    margin-block-end: var(--space-md);
  }
</style>
