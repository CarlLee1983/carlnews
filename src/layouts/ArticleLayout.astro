---
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import FontSizeControl from "../components/FontSizeControl.astro";
import Giscus from "../components/Giscus.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { siteConfig } from "../config/site";
import { categoryHref, getSeriesPosts, postHref } from "../utils/collections";
import { estimateReadingMinutes, normalizeTaxonomy } from "../utils/content";
import { buildShareUrls } from "../utils/share";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: CollectionEntry<"news">;
  posts: CollectionEntry<"news">[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const body = "body" in post && typeof post.body === "string" ? post.body : "";
const dateFormatter = new Intl.DateTimeFormat("zh-TW", {
  dateStyle: "long",
  timeZone: "Asia/Taipei",
});
const index = posts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 ? posts[index + 1] : undefined;
const seriesPosts = post.data.series
  ? getSeriesPosts(posts, post.data.series)
  : [];
const canonical = post.data.canonicalUrl;
const pageUrl = new URL(postHref(post), Astro.site);
const shareUrls = buildShareUrls({
  title: post.data.title,
  pageUrl: pageUrl.href,
  canonicalUrl: canonical,
});
const personId = new URL("/about/#person", Astro.site).href;
const newsJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.data.title,
  description: post.data.description,
  articleSection: post.data.category,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  inLanguage: siteConfig.language,
  mainEntityOfPage: canonical ?? pageUrl.href,
  author: { "@id": personId },
  publisher: { "@id": personId },
  image: post.data.cover
    ? new URL(post.data.cover.src, Astro.site).href
    : new URL(siteConfig.defaultSocialImage, Astro.site).href,
  keywords: [post.data.category, ...post.data.tags].join(", "),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover?.src}
  imageAlt={post.data.coverAlt}
  canonicalUrl={canonical}
  type="article"
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
  tags={post.data.tags}
  jsonLd={newsJsonLd}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="page shell">
    <header class="article-header">
      <div class="article-header__badges">
        <a class="category-badge" href={categoryHref(post.data.category)}>
          {post.data.category}
        </a>
        {
          post.data.draft && (
            <span class="eyebrow">草稿預覽，不會出現在 production build</span>
          )
        }
      </div>

      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p class="article-header__description">{post.data.description}</p>

      <div class="article-meta">
        <div class="meta-item">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <time datetime={post.data.publishDate.toISOString()}>
            發布於 {dateFormatter.format(post.data.publishDate)}
          </time>
        </div>
        {
          post.data.updatedDate && (
            <>
              <span class="meta-dot">·</span>
              <time datetime={post.data.updatedDate.toISOString()}>
                更新於 {dateFormatter.format(post.data.updatedDate)}
              </time>
            </>
          )
        }
        <span class="meta-dot">·</span>
        <div class="meta-item">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{estimateReadingMinutes(body)} 分鐘閱讀</span>
        </div>
      </div>

      <div class="article-toolbar">
        <ul class="tag-list" aria-label="時事標籤">
          {
            post.data.tags.map((tag) => (
              <li>
                <a
                  class="tag"
                  href={`/tags/${encodeURIComponent(normalizeTaxonomy(tag))}/`}
                >
                  {tag}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="article-tools">
          <FontSizeControl />
        </div>
      </div>
    </header>

    {
      post.data.updateNote && post.data.updatedDate && (
        <aside class="update-banner" aria-label="最新進展補充">
          <div class="update-banner__head">
            <strong>UPDATE NOTE // 最新進展補充</strong>
            <time datetime={post.data.updatedDate.toISOString()}>
              {dateFormatter.format(post.data.updatedDate)}
            </time>
          </div>
          <p>{post.data.updateNote}</p>
        </aside>
      )
    }

    {
      post.data.cover && (
        <Image
          class="article-cover"
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1200px) 1120px, calc(100vw - 2rem)"
          loading="eager"
        />
      )
    }

    <section class="executive-brief" aria-labelledby="executive-brief-title">
      <div class="executive-brief__head">
        <h2 id="executive-brief-title" class="executive-brief__title">
          DISPATCH BRIEF // 三問速覽
        </h2>
        <span class="executive-brief__sub">
          WHAT HAPPENED · WHY IT MATTERS · WHAT TO WATCH
        </span>
      </div>
      <dl class="executive-brief__grid">
        <div class="executive-brief__item">
          <dt>
            <span class="brief-num">01</span>
            <span class="brief-en">WHAT HAPPENED</span>
            <strong>發生什麼事</strong>
          </dt>
          <dd>{post.data.whatHappened}</dd>
        </div>
        <div class="executive-brief__item">
          <dt>
            <span class="brief-num">02</span>
            <span class="brief-en">WHY IT MATTERS</span>
            <strong>為什麼重要</strong>
          </dt>
          <dd>{post.data.whyItMatters}</dd>
        </div>
        <div class="executive-brief__item">
          <dt>
            <span class="brief-num">03</span>
            <span class="brief-en">WHAT TO WATCH</span>
            <strong>後續怎麼看</strong>
          </dt>
          <dd>{post.data.whatNext}</dd>
        </div>
      </dl>
    </section>

    <div class="article-body">
      <TableOfContents headings={headings} />
      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="article-footer">
      <section class="article-sources" aria-labelledby="article-sources-title">
        <div class="article-sources__head">
          <h2 id="article-sources-title">
            SOURCE PROVENANCE // 消息來源與查核依據
          </h2>
          <span>{post.data.sources.length} 筆一手依據</span>
        </div>
        <ol class="sources-list">
          {
            post.data.sources.map((source, idx) => (
              <li class="source-item">
                <span class="source-index">
                  [{String(idx + 1).padStart(2, "0")}]
                </span>
                <div class="source-content">
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>{source.title}</span>
                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7" />
                      <path d="M7 7h10v10" />
                    </svg>
                  </a>
                  {(source.publisher || source.publishedAt) && (
                    <div class="source-meta">
                      {source.publisher && (
                        <span class="source-publisher">{source.publisher}</span>
                      )}
                      {source.publishedAt && (
                        <time datetime={source.publishedAt.toISOString()}>
                          {dateFormatter.format(source.publishedAt)}
                        </time>
                      )}
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="article-share" aria-labelledby="article-share-title">
        <h2 id="article-share-title">分享這篇時事評論</h2>
        <div class="article-share__actions">
          <a
            href={shareUrls.x}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="分享到 X"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.211l-5.13-6.817-5.967 6.817H1.803l7.73-8.835L1.254 2.25H8.08l4.638 6.176L18.244 2.25Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
              ></path>
            </svg>
            <span>X</span>
          </a>
          <a
            href={shareUrls.linkedIn}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="分享到 LinkedIn"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M20.452 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.851-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.357V9h3.413v1.561h.048c.476-.9 1.637-1.849 3.37-1.849 3.601 0 4.267 2.37 4.267 5.455v6.285ZM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125ZM7.114 20.452H3.555V9h3.559v11.452Z"
              ></path>
            </svg>
            <span>LinkedIn</span>
          </a>
          <a
            href={shareUrls.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="分享到 Facebook"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.095 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.235 2.686.235v2.97h-1.513c-1.49 0-1.956.931-1.956 1.886v2.266h3.328l-.532 3.49h-2.796V24C19.612 23.095 24 18.1 24 12.073Z"
              ></path>
            </svg>
            <span>Facebook</span>
          </a>
          <button
            type="button"
            data-share-copy
            data-share-url={shareUrls.shareUrl}
            aria-label="複製文章連結"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="13" height="13" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path>
            </svg>
            <span>複製連結</span>
          </button>
        </div>
        <p class="article-share__status" data-share-status aria-live="polite">
        </p>
      </section>

      {
        post.data.series && seriesPosts.length > 0 && (
          <section class="series-section" aria-labelledby="series-posts">
            <h2 id="series-posts">事件脈絡追蹤：{post.data.series}</h2>
            <ol class="series-list">
              {seriesPosts.map((item) => (
                <li>
                  <a
                    href={postHref(item)}
                    aria-current={item.id === post.id ? "page" : undefined}
                  >
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )
      }
      {
        (older || newer) && (
          <nav class="post-nav" aria-label="上一篇與下一篇">
            {older ? (
              <a href={postHref(older)}>
                <span>上一篇（較舊）</span>
                <strong>{older.data.title}</strong>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a href={postHref(newer)}>
                <span>下一篇（較新）</span>
                <strong>{newer.data.title}</strong>
              </a>
            )}
          </nav>
        )
      }
      <Giscus />
    </footer>
  </article>
</BaseLayout>

<script>
  import { copyShareUrl } from "../utils/share";

  const progressBar = document.querySelector<HTMLElement>(".reading-progress");
  const prose = document.querySelector<HTMLElement>(".article-body .prose");
  if (progressBar && prose) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = prose.getBoundingClientRect();
      const start = rect.top + window.scrollY - window.innerHeight * 0.5;
      const length = Math.max(rect.height, 1);
      const ratio = (window.scrollY - start) / length;
      progressBar.style.setProperty(
        "--reading-progress",
        String(Math.min(1, Math.max(0, ratio))),
      );
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-share-copy]");
  const shareStatus = document.querySelector<HTMLElement>(
    "[data-share-status]",
  );

  copyButton?.addEventListener("click", async () => {
    const message = await copyShareUrl(
      navigator.clipboard,
      copyButton.dataset.shareUrl ?? "",
    );
    if (shareStatus) shareStatus.textContent = message;
  });
</script>

<style>
  .article-header__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .category-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .category-badge:hover {
    background: var(--color-accent-hover);
    color: var(--color-accent-ink);
  }

  .update-banner,
  .executive-brief {
    max-width: var(--prose-width);
    margin-inline: auto;
    margin-block-end: var(--space-2xl);
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-md);
    background: var(--color-card);
  }

  .update-banner {
    padding: var(--space-md) var(--space-xl);
    border-inline-start: 4px solid var(--color-secondary);
    background: var(--color-secondary-soft);
    display: grid;
    gap: var(--space-xs);
  }

  .update-banner__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-secondary);
    font-variant-numeric: tabular-nums;
  }

  .update-banner p {
    color: var(--color-ink);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .executive-brief {
    border-block-start: var(--rule-masthead) solid var(--color-accent);
    overflow: hidden;
  }

  .executive-brief__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-paper-2);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .executive-brief__title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .executive-brief__sub {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-muted);
    letter-spacing: 0.06em;
  }

  .executive-brief__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
  }

  .executive-brief__item {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .executive-brief__item:first-child {
    border-block-start: none;
  }

  .executive-brief__item dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .brief-num {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .brief-en {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .executive-brief__item dt strong {
    width: 100%;
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .executive-brief__item dd {
    margin: 0;
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  @media (min-width: 52rem) {
    .executive-brief__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .executive-brief__item {
      border-block-start: none;
      border-inline-start: var(--rule-hair) solid var(--color-rule);
    }

    .executive-brief__item:first-child {
      border-inline-start: none;
    }
  }

  .article-sources {
    display: grid;
    gap: 0;
    border: var(--rule-hair) solid var(--color-rule-2);
    border-block-start: var(--rule-strong) solid var(--color-secondary);
    border-radius: var(--radius-md);
    background: var(--color-card);
    overflow: hidden;
  }

  .article-sources__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-paper-2);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .article-sources__head h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .article-sources__head span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .sources-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .source-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
    padding: var(--space-md) var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
  }

  .source-item:first-child {
    border-block-start: none;
  }

  .source-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-secondary);
    font-variant-numeric: tabular-nums;
    padding-block-start: 0.15rem;
  }

  .source-content {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .source-content a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-weight: 600;
    word-break: break-word;
  }

  .source-content a svg {
    flex: none;
    transform: translateY(0.1em);
  }

  .source-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .source-publisher {
    padding: 0.05rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    font-weight: 600;
  }

  .article-share {
    display: grid;
    gap: var(--space-sm);
  }

  .article-share h2 {
    color: var(--color-ink);
    font-size: var(--text-md);
  }

  .article-share__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .article-share__actions a,
  .article-share__actions button {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-sm);
    background: var(--color-card);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .article-share__actions svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
  }

  .article-share__actions a:hover,
  .article-share__actions button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .article-share__status {
    min-height: 1.5em;
    margin: 0;
    color: var(--color-muted);
