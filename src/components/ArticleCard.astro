---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { postHref } from "../utils/collections";
import { estimateReadingMinutes, getArticleListDate } from "../utils/content";

interface Props {
  post: CollectionEntry<"news">;
  headingLevel?: "h2" | "h3";
  /** card：報刊頂線情報卡；row：雙欄格線列表 */
  variant?: "card" | "row";
  /** 是否顯示三問預覽（01 發生什麼事／02 為什麼重要／03 後續怎麼看） */
  showBrief?: boolean;
}

const {
  post,
  headingLevel: Heading = "h2",
  variant = "card",
  showBrief = false,
} = Astro.props;
const cover = post.data.cover;
const body = "body" in post && typeof post.body === "string" ? post.body : "";
const listDate = getArticleListDate(post.data);
const primaryTag =
  post.data.tags && post.data.tags.length > 0 ? post.data.tags[0] : null;
---

<a
  class:list={[
    "article-card-item",
    `article-card-item--${variant}`,
    cover && "article-card-item--with-cover",
  ]}
  href={postHref(post)}
>
  {
    cover && (
      <Image
        class="article-card-item__cover"
        src={cover}
        alt=""
        widths={variant === "row" ? [220, 440] : [440, 720]}
        sizes={
          variant === "row"
            ? "(min-width: 40rem) 8.5rem, 4rem"
            : "(min-width: 54rem) 22rem, 100vw"
        }
        loading="lazy"
      />
    )
  }
  <div class="article-card-item__content">
    <div class="article-card-item__meta">
      <span class="category-chip">{post.data.category}</span>
      {primaryTag && <span class="tag-chip">{primaryTag}</span>}
      <div class="meta-item">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{estimateReadingMinutes(body)} 分鐘</span>
      </div>
      <span class="meta-dot">·</span>
      <time datetime={listDate.datetime}>{listDate.text}</time>
      {post.data.draft && <span class="draft-pill">草稿</span>}
    </div>
    <Heading class="article-card-item__title">{post.data.title}</Heading>
    <p class="article-card-item__desc">{post.data.description}</p>
    {
      showBrief && (
        <dl class="article-card-item__brief">
          <div>
            <dt>
              <span>01</span> 發生什麼事
            </dt>
            <dd>{post.data.whatHappened}</dd>
          </div>
          <div>
            <dt>
              <span>02</span> 為什麼重要
            </dt>
            <dd>{post.data.whyItMatters}</dd>
          </div>
          <div>
            <dt>
              <span>03</span> 後續怎麼看
            </dt>
            <dd>{post.data.whatNext}</dd>
          </div>
        </dl>
      )
    }
  </div>
  <div class="article-card-item__action" aria-hidden="true">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </div>
</a>

<style>
  .article-card-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "content action";
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-xl);
    border: var(--rule-hair) solid var(--color-rule);
    border-block-start: var(--rule-strong) solid var(--color-ink);
    border-radius: var(--radius-md);
    background: var(--color-card);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }

  .article-card-item:hover {
    border-color: var(--color-accent);
    background: var(--color-card-hover);
  }

  .article-card-item__content {
    grid-area: content;
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .article-card-item__action {
    grid-area: action;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    border: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper-2);
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .article-card-item:hover .article-card-item__action {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .article-card-item__cover {
    grid-area: cover;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--color-paper-2);
  }

  .article-card-item--card {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "content";
    align-items: start;
    gap: 0;
    padding: var(--space-lg);
  }

  .article-card-item--card.article-card-item--with-cover {
    grid-template-areas:
      "cover"
      "content";
    grid-template-rows: auto 1fr;
    padding: 0;
    overflow: hidden;
  }

  .article-card-item--card.article-card-item--with-cover
    .article-card-item__cover {
    aspect-ratio: 16 / 9;
    border-radius: 0;
  }

  .article-card-item--card.article-card-item--with-cover
    .article-card-item__content {
    padding: var(--space-lg);
  }

  .article-card-item--card .article-card-item__action {
    display: none;
  }

  .article-card-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-2xs);
  }

  .category-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.5rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.5rem;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .meta-dot {
    color: var(--color-rule-2);
  }

  .draft-pill {
    padding: 0.1rem 0.45rem;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-sm);
    font-weight: 700;
  }

  .article-card-item__title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.32;
    color: var(--color-ink);
  }

  .article-card-item:hover .article-card-item__title {
    color: var(--color-accent);
  }

  .article-card-item__desc {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .article-card-item__brief {
    display: grid;
    gap: var(--space-xs);
    margin: var(--space-xs) 0 0;
    padding-block-start: var(--space-sm);
    border-block-start: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-xs);
  }

  .article-card-item__brief div {
    display: grid;
    gap: 0.15rem;
  }

  .article-card-item__brief dt {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-ink);
    font-weight: 700;
  }

  .article-card-item__brief dt span {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .article-card-item__brief dd {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .article-card-item--row {
    grid-template-columns: 5.5rem minmax(0, 1fr);
    grid-template-areas: "cover content";
    align-items: start;
    gap: var(--space-md) var(--space-lg);
    padding: var(--space-lg) 0;
    border: 0;
    border-block-start: var(--rule-hair) solid var(--color-rule);
    border-radius: 0;
    background: transparent;
  }

  .article-card-item--row:not(.article-card-item--with-cover) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "content";
  }

  .article-card-item--row:hover {
    background: transparent;
    border-color: var(--color-rule);
  }

  .article-card-item--row .article-card-item__cover {
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
  }

  .article-card-item--row .article-card-item__action {
    display: none;
  }

  .article-card-item--row .meta-dot {
    display: none;
  }

  .article-card-item--row .article-card-item__title {
    font-size: var(--text-md);
    line-height: 1.4;
  }

  .article-card-item--row .article-card-item__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  @media (max-width: 39.99rem) {
    .article-card-item--row {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: var(--space-sm);
    }

    .article-card-item--row:not(.article-card-item--with-cover) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 40rem) {
    .article-card-item--row {
      grid-template-columns: 8.5rem minmax(0, 1fr) auto;
      grid-template-areas: "cover content action";
      align-items: center;
      padding-block: var(--space-xl);
    }

    .article-card-item--row:not(.article-card-item--with-cover) {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "content action";
    }

    .article-card-item--row .article-card-item__action {
      display: grid;
    }

    .article-card-item--row .article-card-item__title {
      font-size: var(--text-lg);
    }

    .article-card-item--row .meta-dot {
      display: inline;
    }
  }
</style>
