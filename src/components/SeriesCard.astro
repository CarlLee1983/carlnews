---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { estimateReadingMinutes } from "../utils/content";

interface Props {
  name: string;
  slug: string;
  posts: CollectionEntry<"news">[];
  index?: number;
}

const { name, slug, posts, index } = Astro.props;

const postWithCover = posts.find((p) => p.data.cover) ?? posts[0];
const cover = postWithCover?.data.cover;

const totalReadingMinutes = posts.reduce((acc, p) => {
  const body = "body" in p && typeof p.body === "string" ? p.body : "";
  return acc + estimateReadingMinutes(body);
}, 0);

const latestPost = posts[posts.length - 1];
const seriesOrderLabel =
  typeof index === "number"
    ? `STORYLINE · ${String(index + 1).padStart(2, "0")}`
    : "STORYLINE";
---

<a class="series-card" href={`/series/${slug}/`}>
  <div class="series-card__head">
    <span class="series-card__badge">{seriesOrderLabel}</span>
    <span class="series-card__counts">
      {posts.length} 篇 · 約 {totalReadingMinutes} 分鐘
    </span>
  </div>

  {
    cover && (
      <div class="series-card__visual">
        <Image
          class="series-card__cover"
          src={cover}
          alt=""
          widths={[400, 720]}
          sizes="(min-width: 54rem) 24rem, 100vw"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="series-card__body">
    <h2 class="series-card__title">{name}</h2>

    {
      latestPost && (
        <div class="series-card__latest">
          <div class="latest-label">
            <span>最新進度</span>
            <span>Vol. {String(posts.length).padStart(2, "0")}</span>
          </div>
          <p class="latest-title">{latestPost.data.title}</p>
        </div>
      )
    }

    <div class="series-card__action">
      <span>查看事件脈絡</span>
      <svg
        class="action-arrow"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </div>
  </div>
</a>

<style>
  .series-card {
    display: flex;
    flex-direction: column;
    border: var(--rule-hair) solid var(--color-rule-2);
    border-block-start: var(--rule-masthead) solid var(--color-ink);
    border-radius: var(--radius-md);
    background: var(--color-card);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color var(--dur-short) var(--ease-out);
  }

  .series-card:hover {
    border-color: var(--color-accent);
  }

  .series-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-lg);
    border-block-end: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .series-card__badge {
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .series-card__counts {
    color: var(--color-muted);
  }

  .series-card__visual {
    height: 9rem;
    background: var(--color-paper-2);
    overflow: hidden;
  }

  .series-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .series-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-lg);
    gap: var(--space-md);
  }

  .series-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.32;
    color: var(--color-ink);
  }

  .series-card:hover .series-card__title {
    color: var(--color-accent);
  }

  .series-card__latest {
    margin-top: auto;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-paper-2);
    border-inline-start: 2px solid var(--color-secondary);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    display: grid;
    gap: 0.2rem;
  }

  .latest-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-secondary);
    font-variant-numeric: tabular-nums;
  }

  .latest-title {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .series-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-xs);
    border-block-start: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-accent);
  }
</style>
