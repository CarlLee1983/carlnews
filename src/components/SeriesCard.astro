---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { estimateReadingMinutes } from "../utils/content";

interface Props {
  name: string;
  slug: string;
  posts: CollectionEntry<"news">[];
  index?: number;
}

const { name, slug, posts, index } = Astro.props;

const postWithCover = posts.find((p) => p.data.cover) ?? posts[0];
const cover = postWithCover?.data.cover;

const totalReadingMinutes = posts.reduce((acc, p) => {
  const body = "body" in p && typeof p.body === "string" ? p.body : "";
  return acc + estimateReadingMinutes(body);
}, 0);

const latestPost = posts[posts.length - 1];
const seriesOrderLabel =
  typeof index === "number"
    ? `STORYLINE · ${String(index + 1).padStart(2, "0")}`
    : "STORYLINE";
---

<a class="series-card" href={`/series/${slug}/`}>
  <div class="series-card__visual">
    <div class="series-card__badge">{seriesOrderLabel}</div>
    {
      cover ? (
        <Image
          class="series-card__cover"
          src={cover}
          alt=""
          widths={[400, 720]}
          sizes="(min-width: 54rem) 24rem, 100vw"
          loading="lazy"
        />
      ) : (
        <div class="series-card__placeholder" aria-hidden="true">
          <svg
            width="44"
            height="44"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
            <path d="M6 6h10" />
            <path d="M6 10h10" />
          </svg>
        </div>
      )
    }
  </div>

  <div class="series-card__body">
    <div class="series-card__meta">
      <span class="meta-item">{posts.length} 篇追蹤</span>
      <span class="meta-dot">·</span>
      <span class="meta-item">約 {totalReadingMinutes} 分鐘</span>
    </div>

    <h2 class="series-card__title">{name}</h2>

    {
      latestPost && (
        <div class="series-card__latest">
          <div class="latest-label">
            <span>最新進度</span>
            <span>Vol. {String(posts.length).padStart(2, "0")}</span>
          </div>
          <p class="latest-title">{latestPost.data.title}</p>
        </div>
      )
    }

    <div class="series-card__action">
      <span>查看事件脈絡</span>
      <svg
        class="action-arrow"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </div>
  </div>
</a>

<style>
  .series-card {
    display: flex;
    flex-direction: column;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur-short) var(--ease-out);
  }

  .series-card:hover {
    border-color: var(--color-accent);
  }

  .series-card__visual {
    position: relative;
    height: 9rem;
    background: var(--color-paper-2);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .series-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .series-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-muted);
  }

  .series-card__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 2;
    padding: 0.2rem 0.55rem;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 700;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    color: var(--color-accent);
    border: var(--rule-hair) solid var(--color-rule);
  }

  .series-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-lg);
    gap: var(--space-sm);
  }

  .series-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .series-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .series-card:hover .series-card__title {
    color: var(--color-accent);
  }

  .series-card__latest {
    margin-top: auto;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-paper-2);
    border-radius: var(--radius-md);
    display: grid;
    gap: 0.2rem;
  }

  .latest-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
  }

  .latest-title {
    font-size: var(--text-sm);
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .series-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-xs);
    font-size: var(--text-sm);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-accent);
  }
</style>
