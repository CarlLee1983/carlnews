---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { estimateReadingMinutes } from "../utils/content";

interface Props {
  name: string;
  slug: string;
  posts: CollectionEntry<"news">[];
}

const { name, slug, posts } = Astro.props;

const postWithCover = posts.find((p) => p.data.cover) ?? posts[0];
const cover = postWithCover?.data.cover;

const totalReadingMinutes = posts.reduce((acc, p) => {
  const body = "body" in p && typeof p.body === "string" ? p.body : "";
  return acc + estimateReadingMinutes(body);
}, 0);

const latestPost = posts[posts.length - 1];
---

<a class="series-card" href={`/series/${slug}/`}>
  <div class="series-card__head">
    <span class="series-card__badge">事件脈絡</span>
    <span class="series-card__counts">
      共 {posts.length} 篇 · 約 {totalReadingMinutes} 分鐘
    </span>
  </div>

  {
    cover && (
      <div class="series-card__visual">
        <Image
          class="series-card__cover"
          src={cover}
          alt=""
          widths={[400, 720]}
          sizes="(min-width: 54rem) 24rem, 100vw"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="series-card__body">
    <h2 class="series-card__title">{name}</h2>

    {
      latestPost && (
        <div class="series-card__latest">
          <div class="latest-label">
            <span>最新進度</span>
            <span>第 {posts.length} 篇</span>
          </div>
          <p class="latest-title">{latestPost.data.title}</p>
        </div>
      )
    }

    <div class="series-card__action">
      <span>查看事件脈絡 →</span>
    </div>
  </div>
</a>

<style>
  .series-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
    padding-block: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule-2);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-short) var(--ease-out);
  }

  .series-card:hover {
    border-color: var(--color-accent);
  }

  .series-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .series-card__badge {
    font-weight: 700;
    color: var(--color-muted);
  }

  .series-card__counts {
    color: var(--color-muted);
  }

  .series-card__visual {
    height: 9rem;
    border-radius: var(--radius-sm);
    background: var(--color-paper-2);
    overflow: hidden;
  }

  .series-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .series-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-md);
  }

  .series-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .series-card:hover .series-card__title {
    color: var(--color-accent);
  }

  .series-card__latest {
    margin-top: auto;
    padding-block-start: var(--space-sm);
    border-block-start: var(--rule-hair) solid var(--color-rule);
    display: grid;
    gap: 0.2rem;
  }

  .latest-label {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .latest-title {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: 1.65;
  }

  .series-card__action {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-accent);
  }
</style>
