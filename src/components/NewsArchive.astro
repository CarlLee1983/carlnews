---
import type { CollectionEntry } from "astro:content";
import ArticleCard from "./ArticleCard.astro";
import EmptyState from "./EmptyState.astro";
import Pagination from "./Pagination.astro";
import type { PaginationState } from "../utils/pagination";

interface Props {
  pagination: PaginationState<CollectionEntry<"news">>;
  totalPosts: number;
}

const { pagination, totalPosts } = Astro.props;
---

<div class="page shell news-page">
  <header class="page-header news-header">
    <div class="news-header__copy">
      <h1>時事評論索引</h1>
      <p>
        聚焦科技業、AI
        公司、半導體、產品、政策與國際生活時事，拆解發生什麼事、為什麼重要、後續怎麼看。
      </p>
    </div>
    <a class="text-link" href="/category/">
      <span>依版面瀏覽</span>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </header>
  <div class="news-toolbar">
    <p class="muted">
      共 {totalPosts} 篇 · 第 {pagination.current} / {pagination.total} 頁 · 最近更新優先
    </p>
    <form class="archive-search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="archive-query">搜尋時事評論</label>
      <svg
        class="archive-search__icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="archive-query"
        name="q"
        type="search"
        placeholder="在時事評論中搜尋"
        required
      />
      <button type="submit">搜尋</button>
    </form>
  </div>
  {
    pagination.items.length > 0 ? (
      <div class="news-list">
        {pagination.items.map((post) => (
          <ArticleCard post={post} variant="row" />
        ))}
      </div>
    ) : (
      <EmptyState
        title="還沒有正式時事評論"
        description="新增 Markdown 或 MDX 檔並將 draft 設為 false 後，內容會自動出現在這裡、RSS、Sitemap 與搜尋索引。"
        href="/rss.xml"
        action="訂閱 RSS"
      />
    )
  }
  <Pagination pagination={pagination} />
</div>

<style>
  .news-page {
    display: grid;
    gap: var(--space-xl);
  }

  .news-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    max-width: none;
    align-items: end;
    gap: var(--space-lg);
    margin-block-end: 0;
    padding-block-end: var(--space-xl);
    border-block-end: var(--rule-hair) solid var(--color-rule-2);
  }

  .news-header .eyebrow {
    grid-column: 1 / -1;
    margin: 0;
  }

  .news-header__copy {
    display: grid;
    min-width: 0;
    gap: var(--space-xs);
  }

  .news-header__copy p {
    max-width: 48rem;
    color: var(--color-muted);
    font-size: var(--text-md);
  }

  .news-list {
    display: grid;
    gap: 0;
  }

  .news-list > :last-child {
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .news-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
  }

  .news-toolbar p {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .archive-search {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: min(100%, 24rem);
    min-height: 2.65rem;
    padding: 0.2rem 0.25rem 0.2rem var(--space-sm);
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-sm);
    background: var(--color-card);
  }

  .archive-search__icon {
    flex-shrink: 0;
    color: var(--color-muted);
  }

  .archive-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
  }

  .archive-search button {
    flex-shrink: 0;
    min-height: 2.15rem;
    padding-inline: var(--space-md);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .archive-search button:hover,
  .archive-search button:focus-visible {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  @media (max-width: 40rem) {
    .news-header {
      grid-template-columns: minmax(0, 1fr);
    }

    .news-header .text-link {
      justify-self: start;
    }
  }
</style>
